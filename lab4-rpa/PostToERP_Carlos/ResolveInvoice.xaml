          <If DisplayName="If ready to post but a portal field is empty" sap2010:WorkflowViewState.IdRef="If_9">
            <If.Condition>
              <InArgument x:TypeArguments="x:Boolean">[out_ReadyToPost AndAlso (String.IsNullOrWhiteSpace(out_VendorName) OrElse String.IsNullOrWhiteSpace(out_InvoiceNumber) OrElse String.IsNullOrWhiteSpace(out_PONumber) OrElse String.IsNullOrWhiteSpace(out_TotalAmountText))]</InArgument>
            </If.Condition>
            <If.Then>
              <Sequence DisplayName="Then - block posting" sap2010:WorkflowViewState.IdRef="Sequence_22">
                <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_ReadyToPost = False" sap2010:WorkflowViewState.IdRef="Assign_23">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[out_ReadyToPost]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign x:TypeArguments="x:String" DisplayName="Assign out_ErrorMessage - incomplete record" sap2010:WorkflowViewState.IdRef="Assign_24">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[out_ErrorMessage]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["AP_Invoice_Carlos record " &amp; out_RecordId &amp; " is missing VendorName, InvoiceNumber, PONumber or TotalAmount. Fix the record before posting."]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
          </If>
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log resolution" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_5" Message="[&quot;ResolveInvoice: RecordId=&quot; &amp; out_RecordId &amp; &quot; | ReadyToPost=&quot; &amp; out_ReadyToPost.ToString() &amp; &quot; | AlreadyPosted=&quot; &amp; out_AlreadyPosted.ToString() &amp; &quot; | Invoice=&quot; &amp; out_InvoiceNumber &amp; &quot; | Error=&quot; &amp; out_ErrorMessage]" />
  </Sequence>
</Activity>
