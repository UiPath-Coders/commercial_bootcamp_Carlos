  <!--
    Main.xaml - Lab 2 (Commercial Bootcamp, Invoice-to-Pay) for Carlos.
    Lists the InvoiceInbox_Carlos storage bucket and processes the files strictly one at a time through
    ProcessInvoiceFile.xaml. Each file is its own transaction: a bad file is logged and skipped, the batch continues.

    Contract:
      FileName         blank = every file in the bucket; otherwise only the file with that name (or bucket path).
      CreateQueueItem  single-file mode only: True = queue a newly created record (Reference = record Id); False = the
                       caller owns queueing. Batch mode (FileName blank) always queues every newly created record.
      ProcessedCount / CreatedCount / RejectedCount  batch totals (duplicates and failures are counted in the summary log).
      RecordId / IsValid / WasDuplicate / ErrorMessage  outcome of the last processed file - with FileName set,
                       that is exactly the requested file. IsValid is True for Created and Duplicate outcomes.
  -->
  <x:Members>
    <x:Property Name="FileName" Type="InArgument(x:String)" />
    <x:Property Name="CreateQueueItem" Type="InArgument(x:Boolean)" />
    <x:Property Name="ProcessedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="CreatedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="RejectedCount" Type="OutArgument(x:Int32)" />
    <x:Property Name="RecordId" Type="OutArgument(x:String)" />
    <x:Property Name="IsValid" Type="OutArgument(x:Boolean)" />
    <x:Property Name="WasDuplicate" Type="OutArgument(x:Boolean)" />
    <x:Property Name="ErrorMessage" Type="OutArgument(x:String)" />
  </x:Members>
